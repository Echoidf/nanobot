{
  "agents": {
    "defaults": {
      "workspace": "~/.nanodesk/workspace",
      "modelPreset": null,
      "model": "anthropic/claude-opus-4-8",
      "provider": "auto",
      "maxTokens": 8192,
      "contextWindowTokens": 200000,
      "contextBlockLimit": null,
      "temperature": 0.1,
      "fallbackModels": [],
      "maxToolIterations": 200,
      "maxConcurrentSubagents": 1,
      "failOnToolError": true,
      "maxToolResultChars": 16000,
      "providerRetryMode": "standard",
      "toolHintMaxLength": 40,
      "reasoningEffort": null,
      "timezone": "UTC",
      "timezoneMode": "auto",
      "botName": "NanoDesk",
      "botIcon": "/brand/nanodesk_favicon.svg",
      "unifiedSession": false,
      "disabledSkills": [],
      "idleCompactAfterMinutes": 15,
      "idleCompactCheckIntervalSeconds": 60,
      "consolidationRatio": 0.5,
      "dream": {
        "enabled": true,
        "intervalH": 2,
        "modelOverride": null
      }
    },
    "profiles": [
      {
        "id": "assistant",
        "name": "通用助手",
        "icon": "🤖",
        "description": "多面手示例（草稿）：日常问答、查资料、写代码都可以找它；把 status 改为 active 即启用",
        "status": "draft",
        "modelPreset": null,
        "systemPrompt": null,
        "skills": [],
        "tools": []
      }
    ]
  },
  "channels": {
    "sendProgress": true,
    "sendToolHints": true,
    "showReasoning": true,
    "extractDocumentText": true,
    "sendMaxRetries": 3,
    "transcriptionProvider": "groq",
    "transcriptionLanguage": null,
    "websocket": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 8765,
      "unixSocketPath": "",
      "path": "/",
      "publicWsUrl": "",
      "token": "",
      "tokenIssuePath": "",
      "tokenIssueSecret": "CHANGE_ME_to_a_long_random_string",
      "trustedProxyAuth": null,
      "tokenTtlS": 300,
      "websocketRequiresToken": true,
      "allowFrom": [
        "*"
      ],
      "streaming": true,
      "maxMessageBytes": 37748736,
      "pingIntervalS": 20.0,
      "pingTimeoutS": 20.0,
      "sslCertfile": "",
      "sslKeyfile": ""
    }
  },
  "transcription": {
    "enabled": true,
    "provider": null,
    "model": null,
    "language": null,
    "maxDurationSec": 120,
    "maxUploadMb": 25
  },
